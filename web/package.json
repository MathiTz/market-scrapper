    "lucide-react": "^0.468.0",
    "posthog-js": "^1.435.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "2.0.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
