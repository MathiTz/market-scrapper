{
  "name": "mercado-em-dia-ui-handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "npm run tokens",
    "dev": "vite",
    "tokens": "node tokens/build.mjs",
    "tokens:check": "node tokens/check.mjs",
