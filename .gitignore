# Python
__pycache__/
*.py[cod]
*.so

# Virtual environment
venv/

# Environment
.env

# Database (and local backups of it)
*.db
*.db-wal
*.db-shm
*.sqlite
backups/

# Mirrored product images (generated; see services/image_mirror.py)
/scraping/images/

# Review artifacts for the missing-image backfill: the CSV and its URLs are committed, the
# downloaded files are not (they are already in the mirror, and 11 MB is a permanent cost)
/scraping/data/missing-images/images/

# Real receipt photos used to try the OCR by hand: they show a CPF, so they never go in the repo
/scraping/tests/fixtures/receipts-private/

# Generated output
diagnostics/

# Local tooling state (not part of the app)
.motion/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Logs and stray local files
*.log
*.bak
