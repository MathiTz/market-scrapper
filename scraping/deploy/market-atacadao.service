[Unit]
Description=Scrape Atacadão's whole price list, then validate and publish (the other chains keep their last lists)
After=network-online.target exit-tunnel.service
Wants=network-online.target exit-tunnel.service

[Service]
Type=oneshot
WorkingDirectory=/opt/market-scrapper/scraping
# Atacadão has no deals, only an everyday price list of about 4,300 grocery products that takes ~10 minutes to
# read, so it runs once a day on its own and market-release.service skips it (--skip atacadao). refresh.py
# publishes the stored lists of every chain, so this run republishes the others unchanged.
ExecStart=/opt/market-scrapper/scraping/venv/bin/python refresh.py --only atacadao
TimeoutStartSec=2h
Nice=5
