[Unit]
Description=GBarbosa's full catalogue at 04:00 Fortaleza time

[Timer]
# An hour after Atacadão (03:00) so the two never scrape at once, and away from the release (06:00 / 18:00),
# the locations sync (07:00 / 19:00) and the nightly pull (23:30).
OnCalendar=*-*-* 04:00:00 America/Fortaleza
Persistent=true

[Install]
WantedBy=timers.target
