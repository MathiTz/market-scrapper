# Database URL (defaults to SQLite in project root)
# DATABASE_URL=sqlite:///market.db

# Cloud Postgres (Neon) that the API reads; the scheduler publishes to it after each scrape.
# Keep the real value only in .env (git-ignored), never in this file.
# PUBLISH_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Flask secret key
SECRET_KEY=change-me

# Scraping defaults (empty query = ALL products from offers pages)
DEFAULT_QUERY=
DEFAULT_LIMIT=1000
SCRAPE_INTERVAL_HOURS=12

# Scraper retry/timeout configuration
SCRAPE_MAX_RETRIES=3
SCRAPE_RETRY_BACKOFF=2.0
SCRAPE_TIMEOUT=15

# Flask server
HOST=0.0.0.0
PORT=5050
DEBUG=true
